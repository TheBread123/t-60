  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>AIM OF THE GAME</b>\n\nT-60 is a fast-paced 2-player card duel. Each
    match is governed by a shared Main Clock \u2014 if it reaches 0:00 during your
    turn, you lose instantly, so every second counts.\n\nOn your turn, play a card
    from your hand to attack your opponent, defend yourself, or manipulate the clocks.
    Cards come in three categories: Offensive, Defensive, and Neutral.\n\nYou also
    lose if you ever start your turn with an empty hand (Resource Exhaustion), so
    manage your cards carefully. Some rare effects can even grant an Immediate Victory
    outright."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 43e7fe925486b8741a4dab03f18f1859, type: 2}
  m_sharedMaterial: {fileID: 8089323097210106302, guid: 43e7fe925486b8741a4dab03f18f1859, type: 2}
