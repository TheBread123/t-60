--- !u!114 &300000155
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 300000152}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PARTS OF THE UI</b>\n\n<b>Main Clock</b> \u2014 the shared timer. Reaching
    0:00 on your turn ends the match in your opponent's favor.\n\n<b>Turn Clock</b>
    \u2014 your personal per-turn countdown. If it runs out before you play a card,
    you automatically lose a random card from your hand and the timer resets.\n\n<b>Hand</b>
    \u2014 your row of cards at the bottom of the screen. Select and play a card
    to trigger its effect.\n\n<b>Action Log</b> \u2014 tracks every move made during
    the match; review the full history on the Game Over screen.\n\n<b>Firewall Shield</b>
    \u2014 while active, the next Offensive card played against you is blocked automatically."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 43e7fe925486b8741a4dab03f18f1859, type: 2}
  m_sharedMaterial: {fileID: 8089323097210106302, guid: 43e7fe925486b8741a4dab03f18f1859, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
